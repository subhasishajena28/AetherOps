# Copy to .env.local for a standalone local frontend. No credentials required.
VITE_AUTH_MODE=local
VITE_API_URL=http://127.0.0.1:8000
# For hosted auth set VITE_AUTH_MODE=hosted and supply the following public settings.
# Set VITE_API_URL to the Render HTTPS origin (no /api); rebuild Vercel after changing it.
# Never publish the local defaults as production settings. VITE_* values are public.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional only for the hosted Design Arena popup integration; otherwise use Supabase OAuth.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=
# Vercel server-only gateway configuration. NEVER use a VITE_ prefix for private keys.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SCANNER_GATEWAY_SECRET=
