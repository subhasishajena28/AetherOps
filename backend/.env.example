# Local configuration (the file backend/.env is loaded on startup).
STORAGE_MODE=sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: absolute SQLite URL. The default is ~/.aetherops/aetherops.sqlite3.
# DATABASE_URL=sqlite:////absolute/path/aetherops.sqlite3
# Hosted gateway mode uses persistent Supabase PostgreSQL, not local SQLite.
# In Render's Environment settings use STORAGE_MODE=gateway; leave DATABASE_URL unset.
# CORS_ORIGINS and GATEWAY_URL must use the Vercel HTTPS origin, with no route path.
# Copy the public URL/key from the same Supabase project configured on Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GATEWAY_URL=
# Generate once; set the same private value on Render and in the Vercel server environment.
SCANNER_GATEWAY_SECRET=
# Optional, server-only. Missing key and provider failures use explicit local rule guidance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
